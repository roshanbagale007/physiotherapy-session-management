      "name": "1. System & Actuator Health",
      "item": [
        {
          "name": "Actuator Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Application is UP', function () { var json = pm.response.json(); pm.expect(json.status).to.eql('UP'); });",
                  "pm.test('Database connection is valid', function () { var json = pm.response.json(); pm.expect(json.components.db.status).to.eql('UP'); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
